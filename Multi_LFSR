`timescale 1ns / 1ps

// ==========================================
// 子模組 1：4-bit LFSR (特徵多項式: x^4 + x^3 + 1)
// ==========================================
module LFSR_4bit(input clk, input rst, input en, output reg [3:0] q);
    always @(posedge clk or posedge rst) begin
        if (rst) 
            q <= 4'h1; // LFSR 初始值(Seed)絕對不能為全 0
        else if (en) 
            q <= {q[2:0], q[3] ^ q[2]}; // 向左 Shift，最低位補 XOR 結果
    end
endmodule

// ==========================================
// 子模組 2：8-bit LFSR (特徵多項式: x^8 + x^6 + x^5 + x^4 + 1)
// ==========================================
module LFSR_8bit(input clk, input rst, input en, output reg [7:0] q);
    always @(posedge clk or posedge rst) begin
        if (rst) 
            q <= 8'h01;
        else if (en) 
            q <= {q[6:0], q[7] ^ q[5] ^ q[4] ^ q[3]};
    end
endmodule

// ==========================================
// 子模組 3：16-bit LFSR (特徵多項式: x^16 + x^14 + x^13 + x^11 + 1)
// ==========================================
module LFSR_16bit(input clk, input rst, input en, output reg [15:0] q);
    always @(posedge clk or posedge rst) begin
        if (rst) 
            q <= 16'h0001;
        else if (en) 
            q <= {q[14:0], q[15] ^ q[13] ^ q[12] ^ q[10]};
    end
endmodule

// ==========================================
// 頂層模組：切換與多工輸出
// ==========================================
module Multi_LFSR(
    input clk,
    input rst,
    input [1:0] mode,       // 切換模式：00(4-bit), 01(8-bit), 10(16-bit)
    output reg [15:0] lfsr_out // 統一輸出為 16-bit，短的 LFSR 前面補 0
);

    wire [3:0]  q_4;
    wire [7:0]  q_8;
    wire [15:0] q_16;

    // 實體化三個子模組
    LFSR_4bit  u_lfsr4  (.clk(clk), .rst(rst), .en(mode == 2'b00), .q(q_4));
    LFSR_8bit  u_lfsr8  (.clk(clk), .rst(rst), .en(mode == 2'b01), .q(q_8));
    LFSR_16bit u_lfsr16 (.clk(clk), .rst(rst), .en(mode == 2'b10), .q(q_16));

    // 根據 mode 切換輸出 (MUX)
    always @(*) begin
        case(mode)
            2'b00: lfsr_out = {12'b0, q_4}; // 4-bit 輸出，前面補 12 個 0
            2'b01: lfsr_out = {8'b0, q_8};  // 8-bit 輸出，前面補 8 個 0
            2'b10: lfsr_out = q_16;         // 16-bit 輸出
            default: lfsr_out = 16'b0;
        endcase
    end
endmodule
