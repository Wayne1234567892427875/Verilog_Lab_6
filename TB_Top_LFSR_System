`timescale 1ns / 1ps

module TB_Top_LFSR_System;
    reg clk;
    reg rst;
    reg [1:0] div_mode;
    reg [1:0] duty_mode;
    reg [1:0] lfsr_mode;
    wire [3:0] LED_out; // 配合實體 4 顆 LED 的輸出

    // 實體化頂層系統
    Top_LFSR_System UUT (
        .clk(clk),
        .rst(rst),
        .div_mode(div_mode),
        .duty_mode(duty_mode),
        .lfsr_mode(lfsr_mode),
        .LED_out(LED_out)
    );

    // 系統時脈 100MHz (10ns)
    always #5 clk = ~clk;

    initial begin
        // ====================================================
        // 初始化狀態
        // ====================================================
        clk = 0;
        rst = 1;
        div_mode  = 2'b00; // 預設：除以 10 (慢週期 100ns)
        duty_mode = 2'b01; // 預設：50% Duty Cycle
        lfsr_mode = 2'b10; // 預設：直接開大絕，16-bit LFSR
        
        #20 rst = 0;

        // ====================================================
        // 劇本 1：16-bit LFSR 高速亂數展示
        // 設定：除以 10 (週期 100ns)，跑 30 個慢週期 = 3000ns
        // 預期：LED 呈現非常均勻且快速的真亂數跳動
        // ====================================================
        #3000; 

        // ====================================================
        // 劇本 2：降級為 8-bit LFSR
        // 設定：頻率不變，跑 20 個慢週期 = 2000ns
        // ====================================================
        lfsr_mode = 2'b01;
        #2000;

        // ====================================================
        // 劇本 3：降級為 4-bit LFSR
        // 設定：頻率不變，跑 20 個慢週期 = 2000ns
        // ====================================================
        lfsr_mode = 2'b00;
        #2000;

        // ====================================================
        // 劇本 4：頻率大變換！切換到最慢的除頻倍率 (除以 100)
        // 設定：慢週期變成 1000ns！LFSR 維持 4-bit，50% Duty
        // 預期：波形圖上的跳動會突然變得很寬，跑 5 個慢週期 = 5000ns
        // ====================================================
        div_mode = 2'b11;
        #5000;

        // ====================================================
        // 劇本 5：觀察 Duty Cycle 變窄 (25%)
        // 設定：頻率極慢 (週期 1000ns)，Duty 變成 25% (250ns 高 / 750ns 低)
        // 預期：在波形圖上，slow_clk 的高電位會變得非常像一根「尖刺」
        // ====================================================
        duty_mode = 2'b00;
        #5000;

        // ====================================================
        // 劇本 6：觀察 Duty Cycle 變寬 (75%)
        // 設定：頻率極慢 (週期 1000ns)，Duty 變成 75% (750ns 高 / 250ns 低)
        // 預期：slow_clk 高電位維持很久，快要結束時才掉下去
        // ====================================================
        duty_mode = 2'b10;
        #5000;

        // ====================================================
        // 劇本 7：極限測試！(除以 20, 100% 恆亮, 16-bit LFSR)
        // 設定：慢週期 200ns，因為 100% Duty，所以 slow_clk 幾乎不會掉下來
        // 預期：這是一個邊界測試，看電路在接近 100% 恆亮時是否會出錯。跑 10000ns。
        // ====================================================
        div_mode  = 2'b01;
        duty_mode = 2'b11; 
        lfsr_mode = 2'b10;
        #10000;

        // 結束模擬
        $stop;
    end
endmodule
